<!doctype html>
<html lang="pt-BR" class="text-gray-900 antialiased">

  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f97316" />
    <meta name="description" content="Plataforma Benício Advogados para gestão jurídica." />

    <title inertia>Benício</title>

    <link rel="icon" type="image/png" href="/yol/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;600&family=Work+Sans:wght@600&display=swap"
      rel="stylesheet"
    />

    @stack('dumper')
    @viteReactRefresh()
    @inertiaHead()
    @vite(['inertia/app/app.tsx', `inertia/pages/${page.component}.tsx`])
  </head>

  <body>
    @inertia()
  </body>

</html>
