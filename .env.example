TZ=UTC
HOST=localhost
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3333
VITE_APP_NAME=Benício
APP_KEY=
LOG_LEVEL=info

SESSION_DRIVER=cookie
LIMITER_STORE=database

# Drive (file storage): fs | s3 | spaces | r2 | gcs
DRIVE_DISK=fs

# Database Configuration (PostgreSQL)
# DB_CONNECTION selects the connection in config/database.ts (postgres | sqlite)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=benicio

# Redis (cache + sessions)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue (redis | sync). Production should use Redis; tests use sync.
QUEUE_DRIVER=redis

# AI chat (disabled | multi | openai_compatible)
# "multi" uses deterministic fast/deep profiles across Groq and NVIDIA NIM.
AI_PROVIDER=disabled
# AI_DEFAULT_PROFILE=fast
# AI_GROQ_API_KEY=
# AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
# AI_GROQ_FAST_MODEL=llama-3.3-70b-versatile
# AI_GROQ_DEEP_MODEL=openai/gpt-oss-120b
# AI_NVIDIA_API_KEY=
# AI_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI_NVIDIA_FAST_MODEL=deepseek-ai/deepseek-v4-flash
# AI_NVIDIA_DEEP_MODEL=z-ai/glm-5.2
# AI_NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
# AI_NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
# AI_NVIDIA_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
# AI_NVIDIA_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-1b-v2/reranking
# AI_RETRIEVAL_TIMEOUT_MS=60000
# AI_RETRIEVAL_BATCH_SIZE=32
# AI_RETRIEVAL_MAX_FILE_BYTES=26214400
# AI_RETRIEVAL_MAX_SOURCE_CHARS=2000000
# AI_RETRIEVAL_CHUNK_CHARS=3500
# AI_RETRIEVAL_CHUNK_OVERLAP_CHARS=350
# AI_RETRIEVAL_CANDIDATE_MULTIPLIER=5

# Qdrant is a derived index. PostgreSQL remains the legal data/ACL source of truth.
# The project compose maps Qdrant to 6335 to avoid the host Cortex service on 6333.
QDRANT_URL=http://127.0.0.1:6335
# QDRANT_API_KEY=
QDRANT_COLLECTION=benicio_legal_documents
# QDRANT_TIMEOUT_MS=10000

# Legacy single OpenAI-compatible provider (when AI_PROVIDER=openai_compatible)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# Range: 1000-300000 milliseconds
# AI_TIMEOUT_MS=60000
# Range: 1-100 completed messages from the current conversation only
# AI_MAX_CONTEXT_MESSAGES=24
# AI_MAX_CONTEXT_CHARS=120000
# AI_TURN_LEASE_MS=600000
# AI_STREAM_HEARTBEAT_MS=15000
# AI_SYSTEM_PROMPT="Você é o assistente jurídico do Benício."
# AI_PROMPT_VERSION=legal-chat-v1
# AI_RETRY_MAX_ATTEMPTS=2
# AI_RETRY_BASE_DELAY_MS=250
# AI_CIRCUIT_FAILURE_THRESHOLD=3
# AI_CIRCUIT_RESET_MS=30000
# AI_FAST_CONNECT_TIMEOUT_MS=5000
# AI_FAST_FIRST_TOKEN_TIMEOUT_MS=15000
# AI_FAST_IDLE_TIMEOUT_MS=30000
# AI_FAST_TOTAL_TIMEOUT_MS=90000
# AI_FAST_MAX_TOKENS=2048
# AI_DEEP_CONNECT_TIMEOUT_MS=5000
# AI_DEEP_FIRST_TOKEN_TIMEOUT_MS=45000
# AI_DEEP_IDLE_TIMEOUT_MS=60000
# AI_DEEP_TOTAL_TIMEOUT_MS=300000
# AI_DEEP_MAX_TOKENS=8192

# Mail Configuration
# MAIL_MAILER: resend | smtp | mailgun
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@benicio.juridicai.com.br
MAIL_FROM_NAME="Benício"

# Resend Configuration (when MAIL_MAILER=resend)
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com

# SMTP Configuration (when MAIL_MAILER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Mailgun Configuration (when MAIL_MAILER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_BASE_URL=https://api.mailgun.net/v3

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill in as needed)
# ---------------------------------------------------------------------------

# OAuth providers (@adonisjs/ally)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# DigitalOcean Spaces (when DRIVE_DISK=spaces)
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_ENDPOINT=

# Cloudflare R2 (when DRIVE_DISK=r2)
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=

# Google Cloud Storage (when DRIVE_DISK=gcs)
# GCS_KEY=
# GCS_BUCKET=
