TZ=UTC
HOST=localhost
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3333
VITE_APP_NAME=Benício
APP_KEY=
LOG_LEVEL=info

SESSION_DRIVER=cookie
LIMITER_STORE=database

# Drive (file storage): fs | s3 | spaces | r2 | gcs
DRIVE_DISK=fs

# Database Configuration (PostgreSQL)
# DB_CONNECTION selects the connection in config/database.ts (postgres | sqlite)
DB_CONNECTION=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=benicio

# Redis (cache + sessions)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Queue (redis | sync). Production should use Redis; tests use sync.
QUEUE_DRIVER=redis

# AI chat (disabled | openai_compatible)
# OpenAI-compatible providers must expose POST {AI_BASE_URL}/chat/completions.
AI_PROVIDER=disabled
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=
# Range: 1000-300000 milliseconds
# AI_TIMEOUT_MS=60000
# Range: 1-200 messages from the current conversation only
# AI_MAX_CONTEXT_MESSAGES=24
# AI_SYSTEM_PROMPT="Você é o assistente jurídico do Benício."

# Mail Configuration
# MAIL_MAILER: resend | smtp | mailgun
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@benicio.juridicai.com.br
MAIL_FROM_NAME="Benício"

# Resend Configuration (when MAIL_MAILER=resend)
RESEND_API_KEY=
# RESEND_BASE_URL=https://api.resend.com

# SMTP Configuration (when MAIL_MAILER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Mailgun Configuration (when MAIL_MAILER=mailgun)
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_BASE_URL=https://api.mailgun.net/v3

# ---------------------------------------------------------------------------
# Optional integrations (uncomment and fill in as needed)
# ---------------------------------------------------------------------------

# OAuth providers (@adonisjs/ally)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# S3 (when DRIVE_DISK=s3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=

# DigitalOcean Spaces (when DRIVE_DISK=spaces)
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=
# SPACES_BUCKET=
# SPACES_ENDPOINT=

# Cloudflare R2 (when DRIVE_DISK=r2)
# R2_KEY=
# R2_SECRET=
# R2_BUCKET=
# R2_ENDPOINT=

# Google Cloud Storage (when DRIVE_DISK=gcs)
# GCS_KEY=
# GCS_BUCKET=
