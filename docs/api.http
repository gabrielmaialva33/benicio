### Benício API HTTP Requests
### Base URL: http://localhost:3333
###
### Authentication: Most endpoints require JWT Bearer token
### Include header: Authorization: Bearer <token>
###
### API Conventions:
### - Content-Type: application/json (except file uploads)
### - Timestamps: ISO 8601 format
### - Database fields: snake_case naming
### - Pagination: ?page=1&per_page=10
### - Sorting: ?sort_by=field&order=asc|desc
### - Search: ?search=term

### Variables (replace with actual values)
@baseUrl = http://localhost:3333
@token = replace-with-access-token
@refreshToken = replace-with-refresh-token
@userId = 3
@roleId = 3
@tenantId = 1
@clientId = 1
@folderId = 1
@processId = 1
@taskId = 1
@hearingId = 1
@deadlineId = 1
@movementId = 1
@fileId = 1
@documentId = 1
@notificationId = 1
@messageId = 1
@conversationId = 1
@transmitUid = replace-with-transmit-uid

###############################################################################
### HEALTH ENDPOINTS
###############################################################################

### Get API Information
GET {{baseUrl}}/version
Accept: application/json

### Health Check
GET {{baseUrl}}/api/v1/health
Accept: application/json

###############################################################################
### AUTHENTICATION ENDPOINTS
###############################################################################

### Sign In (Login)
# Returns access_token and refresh_token
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json

{
  "uid": "john@example.com",
  "password": "password123"
}

### Sign In with Username
POST {{baseUrl}}/api/v1/sessions/sign-in
Content-Type: application/json

{
  "uid": "johndoe",
  "password": "password123"
}

### Sign Up (Register)
# Creates new user account and returns tokens
POST {{baseUrl}}/api/v1/sessions/sign-up
Content-Type: application/json

{
  "full_name": "John Doe",
  "email": "john@example.com",
  "username": "johndoe",
  "password": "password123",
  "password_confirmation": "password123"
}

### Sign Up (Minimal - without username)
POST {{baseUrl}}/api/v1/sessions/sign-up
Content-Type: application/json

{
  "full_name": "Jane Smith",
  "email": "jane@example.com",
  "password": "password123",
  "password_confirmation": "password123"
}

###############################################################################
### PROFILE ENDPOINTS (Requires Authentication)
###############################################################################

### Get Current User Profile
GET {{baseUrl}}/api/v1/me
Authorization: Bearer {{token}}
Accept: application/json

### Get Current User Permissions
GET {{baseUrl}}/api/v1/me/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Get Current User Roles
GET {{baseUrl}}/api/v1/me/roles
Authorization: Bearer {{token}}
Accept: application/json

###############################################################################
### EMAIL VERIFICATION ENDPOINTS
###############################################################################

### Verify Email
# This endpoint is typically opened from a link in an email
GET {{baseUrl}}/api/v1/verify-email?token=VERIFICATION_TOKEN
Accept: application/json

### Resend Verification Email (Requires Authentication)
POST {{baseUrl}}/api/v1/resend-verification-email
Authorization: Bearer {{token}}
Accept: application/json

###############################################################################
### USER MANAGEMENT ENDPOINTS (Requires Authentication)
###############################################################################

### List Users
# Paginated list with search and sorting
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Accept: application/json

### List Users with Pagination
GET {{baseUrl}}/api/v1/users?page=1&per_page=20
Authorization: Bearer {{token}}
Accept: application/json

### List Users with Sorting
GET {{baseUrl}}/api/v1/users?sort_by=created_at&order=desc
Authorization: Bearer {{token}}
Accept: application/json

### Search Users
GET {{baseUrl}}/api/v1/users?search=john
Authorization: Bearer {{token}}
Accept: application/json

### Get User by ID
GET {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Accept: application/json

### Create User (Requires USER role)
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "full_name": "New User",
  "email": "newuser@example.com",
  "username": "newuser",
  "password": "password123",
  "password_confirmation": "password123"
}

### Update User
# Note: email and username cannot be changed
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "full_name": "John Updated Doe"
}

### Update User Password
PUT {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "password": "newpassword123",
  "password_confirmation": "newpassword123"
}

### Delete User (Soft Delete)
DELETE {{baseUrl}}/api/v1/users/{{userId}}
Authorization: Bearer {{token}}

###############################################################################
### ROLE MANAGEMENT ENDPOINTS (Requires ADMIN or ROOT role)
###############################################################################

### List Roles
GET {{baseUrl}}/api/v1/admin/roles
Authorization: Bearer {{token}}
Accept: application/json

### List Roles with Pagination
GET {{baseUrl}}/api/v1/admin/roles?page=1&per_page=10
Authorization: Bearer {{token}}
Accept: application/json

### Attach Roles to User
PUT {{baseUrl}}/api/v1/admin/roles/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 1,
  "role_ids": [
    1,
    2,
    3
  ]
}

### Attach Single Role to User
PUT {{baseUrl}}/api/v1/admin/roles/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 2,
  "role_ids": [
    2
  ]
}

###############################################################################
### PERMISSION MANAGEMENT ENDPOINTS (Requires ADMIN or ROOT role)
###############################################################################

### List Permissions
GET {{baseUrl}}/api/v1/admin/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Create Permission
POST {{baseUrl}}/api/v1/admin/permissions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "resource": "posts",
  "action": "create",
  "description": "Allow creating posts"
}

### Sync Role Permissions
PUT {{baseUrl}}/api/v1/admin/roles/permissions/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    1,
    2,
    3
  ]
}

### Attach Permissions to Role
PUT {{baseUrl}}/api/v1/admin/roles/permissions/attach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    4,
    5
  ]
}

### Detach Permissions from Role
PUT {{baseUrl}}/api/v1/admin/roles/permissions/detach
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_id": 2,
  "permission_ids": [
    1
  ]
}

### Sync User Direct Permissions
PUT {{baseUrl}}/api/v1/admin/users/permissions/sync
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 3,
  "permission_ids": [
    10,
    11
  ]
}

### Get User's Direct Permissions
GET {{baseUrl}}/api/v1/admin/users/{{userId}}/permissions
Authorization: Bearer {{token}}
Accept: application/json

### Check User Permissions
POST {{baseUrl}}/api/v1/admin/users/{{userId}}/permissions/check
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "permissions": [
    "users.create",
    "files.delete"
  ]
}

###############################################################################
### CLIENTS (Requires Authentication, Tenant and Permission)
###############################################################################

### List Clients
GET {{baseUrl}}/api/v1/clients?page=1&per_page=20&sort_by=name&order=asc
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Client
POST {{baseUrl}}/api/v1/clients
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "name": "Banco Exemplo S.A.",
  "document": "AB12.CD34/EF56-01",
  "person_type": "company",
  "email": "juridico@example.com",
  "address": {
    "city": "São Paulo",
    "state": "SP",
    "country": "BR"
  }
}

### Get Client
GET {{baseUrl}}/api/v1/clients/{{clientId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Update Client
PUT {{baseUrl}}/api/v1/clients/{{clientId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "phone": "+55 11 99999-9999"
}

### Soft-delete Client
DELETE {{baseUrl}}/api/v1/clients/{{clientId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### FOLDERS (Requires Authentication, Tenant and Permission)
###############################################################################

### List Folders
GET {{baseUrl}}/api/v1/folders?page=1&per_page=20&status=active&area=Cível%20Contencioso
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Folder
POST {{baseUrl}}/api/v1/folders
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "code": "pasta-001",
  "title": "Contencioso principal",
  "status": "active",
  "area": "Cível Contencioso",
  "subarea": "Bancário",
  "client_id": {{clientId}}
}

### Get Folder
GET {{baseUrl}}/api/v1/folders/{{folderId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Update Folder
PUT {{baseUrl}}/api/v1/folders/{{folderId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "status": "pending"
}

### Soft-delete Folder
DELETE {{baseUrl}}/api/v1/folders/{{folderId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### PROCESSES (Requires Authentication, Tenant and Permission)
###############################################################################

### List Processes Across the Active Tenant
GET {{baseUrl}}/api/v1/processes?page=1&per_page=20&status=active&party_document=12345678900
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### List Processes in a Folder
GET {{baseUrl}}/api/v1/folders/{{folderId}}/processes?page=1&per_page=20
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Process with Parties
POST {{baseUrl}}/api/v1/folders/{{folderId}}/processes
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "cnj_number": "5144506-05.2026.8.09.0112",
  "internal_code": "INT-2026-001",
  "status": "active",
  "instance": "first",
  "phase": "knowledge",
  "electronic": true,
  "is_primary": true,
  "tribunal": "TJGO",
  "district": "Goiânia",
  "case_value": "150000.50",
  "distribution_date": "2026-05-04",
  "parties": [
    {
      "side": "active",
      "role": "claimant",
      "is_primary": true,
      "name": "Cliente Exemplo",
      "document": "123.456.789-00"
    },
    {
      "side": "passive",
      "role": "defendant",
      "is_primary": true,
      "name": "Parte Contrária"
    }
  ]
}

### Get Process
GET {{baseUrl}}/api/v1/processes/{{processId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Update Process and Atomically Replace Parties
PUT {{baseUrl}}/api/v1/processes/{{processId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "phase": "execution",
  "electronic": null,
  "parties": [
    {
      "side": "active",
      "is_primary": true,
      "name": "Cliente Exemplo",
      "document": "123.456.789-00"
    }
  ]
}

### Mark Process as the Folder Primary
PUT {{baseUrl}}/api/v1/processes/{{processId}}/primary
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Soft-delete Process
DELETE {{baseUrl}}/api/v1/processes/{{processId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### FILE MANAGEMENT ENDPOINTS (Requires Authentication)
###############################################################################

### Upload File
# Maximum size: 10MB
# Allowed extensions: jpeg, jpg, png, pdf, doc, docx, txt, csv, xls, xlsx, mp3, mp4, zip
# File is automatically categorized: image, document, video, audio, file
POST {{baseUrl}}/api/v1/files/upload
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="document.pdf"
Content-Type: application/pdf

< ./document.pdf
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### Upload Image
POST {{baseUrl}}/api/v1/files/upload
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="photo.jpg"
Content-Type: image/jpeg

< ./photo.jpg
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###############################################################################
### SESSION LIFECYCLE AND TENANTS
###############################################################################

### Rotate Refresh Token
POST {{baseUrl}}/api/v1/sessions/refresh
Content-Type: application/json

{
  "refresh_token": "{{refreshToken}}"
}

### List My Tenant Memberships
GET {{baseUrl}}/api/v1/tenants/me
Authorization: Bearer {{token}}
Accept: application/json

### Switch Active Tenant (replace local tokens with response.auth)
POST {{baseUrl}}/api/v1/tenants/switch
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tenant_id": {{tenantId}}
}

### Logout Current Token Family
POST {{baseUrl}}/api/v1/sessions/logout
Authorization: Bearer {{token}}

###############################################################################
### TASKS
###############################################################################

### List Open Urgent Tasks
GET {{baseUrl}}/api/v1/tasks?status=pending&priority=urgent&page=1&per_page=20
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Task
POST {{baseUrl}}/api/v1/tasks
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "title": "Revisar contestação",
  "description": "Validar preliminares antes do protocolo",
  "priority": "high",
  "due_date": "2027-03-15T18:00:00.000Z",
  "folder_id": {{folderId}},
  "process_id": {{processId}},
  "assignee_id": {{userId}},
  "tags": ["contencioso", "revisão"]
}

### Update Task Status
PATCH {{baseUrl}}/api/v1/tasks/{{taskId}}/status
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "status": "completed"
}

### Soft-delete Task
DELETE {{baseUrl}}/api/v1/tasks/{{taskId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### HEARINGS AND DEADLINES
###############################################################################

### Create Hearing for Process
POST {{baseUrl}}/api/v1/processes/{{processId}}/hearings
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "title": "Audiência de instrução",
  "type": "instruction",
  "starts_at": "2027-03-20T13:30:00.000Z",
  "ends_at": "2027-03-20T15:00:00.000Z",
  "location": "Fórum Central",
  "attendees": [
    {
      "user_id": {{userId}},
      "role": "responsible_lawyer",
      "is_required": true
    }
  ]
}

### Postpone Hearing
PATCH {{baseUrl}}/api/v1/hearings/{{hearingId}}/status
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "status": "postponed"
}

### List Upcoming Hearings
GET {{baseUrl}}/api/v1/hearings?status=scheduled&folder_id={{folderId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Create Fatal Judicial Deadline
POST {{baseUrl}}/api/v1/deadlines
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "folder_id": {{folderId}},
  "process_id": {{processId}},
  "assignee_id": {{userId}},
  "title": "Interpor apelação",
  "kind": "judicial",
  "priority": "urgent",
  "is_fatal": true,
  "due_at": "2027-03-30T23:59:59.000Z",
  "legal_basis": "CPC, art. 1.003, §5º"
}

### Complete Deadline
PATCH {{baseUrl}}/api/v1/deadlines/{{deadlineId}}/complete
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "completed": true
}

###############################################################################
### MOVEMENTS AND APPEND-ONLY ACTIVITY
###############################################################################

### Idempotently Ingest Court Movement
POST {{baseUrl}}/api/v1/processes/{{processId}}/movements
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "occurred_at": "2027-03-10T14:15:00.000Z",
  "kind": "publication",
  "title": "Intimação publicada",
  "description": "Publicação no diário oficial",
  "source": "court",
  "external_id": "court-event-123"
}

### Update Mutable Movement Metadata
PUT {{baseUrl}}/api/v1/movements/{{movementId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "description": "Publicação conferida pela equipe",
  "metadata": {
    "reviewed": true
  }
}

### Read Folder Activity Timeline
GET {{baseUrl}}/api/v1/folders/{{folderId}}/activities?limit=25
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Read Next Activity Page
# Append &cursor=<meta.next_cursor> from the previous response.
GET {{baseUrl}}/api/v1/processes/{{processId}}/activities?limit=25
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

###############################################################################
### LEGAL DOCUMENTS AND FAVORITES
###############################################################################

### Link an Uploaded File to a Folder/Process
POST {{baseUrl}}/api/v1/documents
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "folder_id": {{folderId}},
  "process_id": {{processId}},
  "file_id": {{fileId}},
  "document_type": "petition",
  "title": "Petição inicial",
  "version": 1,
  "is_signed": false
}

### Mark Legal Document as Signed
PUT {{baseUrl}}/api/v1/documents/{{documentId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "is_signed": true
}

### Add Favorite (Idempotent)
PUT {{baseUrl}}/api/v1/folders/{{folderId}}/favorite
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

### List My Favorite Folders
GET {{baseUrl}}/api/v1/me/favorites/folders
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

###############################################################################
### DASHBOARD
###############################################################################

### Complete Dashboard Snapshot
GET {{baseUrl}}/api/v1/dashboard
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Upcoming Deadline Widget
GET {{baseUrl}}/api/v1/dashboard/upcoming-deadlines?limit=10
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

###############################################################################
### NOTIFICATIONS, MESSAGES, AND REALTIME
###############################################################################

### Deliver Notification (Admin/Root by Default)
POST {{baseUrl}}/api/v1/notifications
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "recipient_id": {{userId}},
  "type": "deadline",
  "title": "Prazo próximo",
  "message": "O prazo vence amanhã",
  "action_url": "http://localhost:3333/deadlines/{{deadlineId}}",
  "action_text": "Abrir prazo",
  "data": {
    "deadline_id": {{deadlineId}}
  }
}

### Count Unread Notifications
GET {{baseUrl}}/api/v1/notifications/unread-count
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Mark Notification Read
PUT {{baseUrl}}/api/v1/notifications/{{notificationId}}/read
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

### Send Internal Message
POST {{baseUrl}}/api/v1/messages
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "recipient_id": {{userId}},
  "subject": "Audiência confirmada",
  "body": "A audiência foi confirmada para amanhã.",
  "priority": "high"
}

### List Sent Messages
GET {{baseUrl}}/api/v1/messages?box=sent&page=1&per_page=20
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Mark Inbox Message Read
PUT {{baseUrl}}/api/v1/messages/{{messageId}}/read
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

### Open Transmit Event Stream (HTTP-only token cookie also supported)
GET {{baseUrl}}/__transmit/events?uid={{transmitUid}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: text/event-stream

### Subscribe to My Notification Channel
POST {{baseUrl}}/__transmit/subscribe
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "uid": "{{transmitUid}}",
  "channel": "tenants/{{tenantId}}/users/{{userId}}/notifications"
}

###############################################################################
### AI CHAT
###############################################################################

### Non-streaming AI Turn
POST {{baseUrl}}/api/v1/ai/chat
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Content-Type: application/json

{
  "message": "Explique a prescrição intercorrente em linguagem objetiva.",
  "mode": "single"
}

### Continue Conversation with SSE Streaming
POST {{baseUrl}}/api/v1/ai/chat/stream
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: text/event-stream
Content-Type: application/json

{
  "message": "Agora resuma em dois parágrafos.",
  "conversation_id": {{conversationId}},
  "mode": "single"
}

### List My AI Conversations
GET {{baseUrl}}/api/v1/ai/conversations?page=1&per_page=20
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Get Conversation with Messages
GET {{baseUrl}}/api/v1/ai/conversations/{{conversationId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}
Accept: application/json

### Delete Conversation
DELETE {{baseUrl}}/api/v1/ai/conversations/{{conversationId}}
Authorization: Bearer {{token}}
x-tenant-id: {{tenantId}}

###############################################################################
### EXAMPLE RESPONSES
###############################################################################

### Success Response - User Object
# {
#   "id": 1,
#   "full_name": "John Doe",
#   "email": "john@example.com",
#   "username": "johndoe",
#   "created_at": "2024-01-01T00:00:00.000Z",
#   "updated_at": "2024-01-01T00:00:00.000Z",
#   "roles": [
#     {
#       "id": 1,
#       "name": "User",
#       "description": "Regular user role",
